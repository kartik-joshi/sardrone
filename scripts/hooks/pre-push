#!/bin/bash
# Re-check every commit about to be pushed, plus private files and private branches (installed by `make hooks`).
root="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"  # the main checkout, also from a worktree
zero=0000000000000000000000000000000000000000
ranges=(); branches=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  branches+=(--branch "${remote_ref#refs/heads/}" --branch "${local_ref#refs/heads/}")
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" "$1/main" 2>/dev/null) || base=""
    if [ -n "$base" ]; then ranges+=("$base..$local_sha"); else ranges+=("$local_sha"); fi
  else
    ranges+=("$remote_sha..$local_sha")
  fi
done
[ ${#ranges[@]} -eq 0 ] && [ ${#branches[@]} -eq 0 ] && exit 0
exec "$root/.venv/bin/python" "$root/scripts/check_secrets.py" --push "${ranges[@]}" "${branches[@]}"
